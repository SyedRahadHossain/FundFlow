PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# The database name must be in the URI, otherwise MongoDB silently uses `test`
# and you will not see your data under the database you expect in Atlas.
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CLIENT_URL=https://your-client.vercel.app
NODE_ENV=production

# Firebase Admin service account (single-line JSON). Required for Google sign-in;
# without it POST /api/auth/google returns 503 instead of trusting the client.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"","private_key_id":"","private_key":"","client_email":"","client_id":""}
